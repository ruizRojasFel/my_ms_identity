    <PackageReference Include="Microsoft.Identity.Web" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MsIdentity.Application\MsIdentity.Application.csproj" />
    <ProjectReference Include="..\MsIdentity.Infrastructure\MsIdentity.Infrastructure.csproj" />
  </ItemGroup>

</Project>
